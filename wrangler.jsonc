{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Public URL: https://<name>.<account-subdomain>.workers.dev → crm.votranlong91.workers.dev
  "name": "crm",
  // worker.ts wraps the OpenNext build (.open-next/worker.js) and adds the daily cron.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: required by Next.js, Prisma's pg adapter and the pg driver.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Run the Worker next to the database (Supabase, AWS ap-southeast-1 Singapore):
  // each query becomes a ~1-3 ms hop instead of a trip from the user's edge
  // location. Static assets are still served from the nearest edge.
  "placement": {
    "mode": "targeted",
    "region": "aws:ap-southeast-1"
  },
  "observability": {
    "enabled": true
  },
  // Non-secret configuration. Secrets (JWT_SECRET, and DATABASE_URL only when not
  // using Hyperdrive) live in Cloudflare: Worker → Settings → Variables and Secrets.
  "vars": {
    "APP_TIMEZONE": "Asia/Ho_Chi_Minh"
  },
  // Database connection pooling + TLS to Supabase (lib/prisma.ts prefers this
  // binding over DATABASE_URL). scripts/deploy-cloudflare.sh fills in the id;
  // keep caching disabled on the Hyperdrive config so reads are never stale.
  // localConnectionString is only used by `npm run preview` (the local Postgres
  // from .env.example); `opennextjs-cloudflare deploy` refuses to run without one.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "46f6c26f737e4a8a8383aee503eb068b",
      "localConnectionString": "postgresql://crm:crm_dev_password@localhost:5432/crm_bu4"
    }
  ],
  // Contract PDFs (lib/file-storage.ts) and daily database backups (lib/maintenance.ts).
  // scripts/deploy-cloudflare.sh creates the buckets; while R2 is not enabled on the
  // account it deploys without them (PDFs stay in Postgres, backups are skipped).
  "r2_buckets": [
    { "binding": "CONTRACT_FILES", "bucket_name": "crm-contract-files" },
    { "binding": "BACKUPS", "bucket_name": "crm-backups" }
  ],
  // 19:00 UTC = 02:00 in Vietnam: backup to R2 and audit-log retention (worker.ts).
  "triggers": {
    "crons": ["0 19 * * *"]
  },
  // Native rate limiting for login / password change (lib/rate-limit.ts).
  // Workers isolates do not share memory, so an in-process counter is not enough.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name used by Workers Builds in the Cloudflare dashboard.
  "name": "crm-bu4",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: required by Next.js, Prisma's pg adapter and the pg driver.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Non-secret configuration. Secrets (DATABASE_URL, JWT_SECRET) are set in the
  // dashboard (Worker → Settings → Variables and Secrets) or with `wrangler secret put`.
  "vars": {
    "APP_TIMEZONE": "Asia/Ho_Chi_Minh"
  },
  // Native rate limiting for login / password change (lib/rate-limit.ts).
  // Workers isolates do not share memory, so an in-process counter is not enough.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
  // Optional, recommended: pool database connections with Hyperdrive.
  // Create one (dashboard → Workers & Pages → Hyperdrive, or
  // `npx wrangler hyperdrive create crm-bu4-db --connection-string="<DATABASE_URL>"`),
  // then add a comma after the ratelimits array above and uncomment:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-id>" }]
}

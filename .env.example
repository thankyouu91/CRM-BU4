# Copy this file to .env and fill in real values.

# PostgreSQL connection string.
# Local example: postgresql://USER:PASSWORD@localhost:5432/crm_bu4?schema=public
# Hosted (Supabase/Neon/RDS) example: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/crm_bu4?schema=public"

# Secret used to sign auth JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

NODE_ENV="development"

# Business timezone for report periods (day/month/quarter/year boundaries).
APP_TIMEZONE="Asia/Ho_Chi_Minh"

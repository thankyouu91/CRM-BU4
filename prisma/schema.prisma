// Prisma schema for CRM-BU4 — project & task management dashboard
// Docs: https://pris.ly/d/prisma-schema

generator client {
  // Queries go through the `pg` driver adapter, which also runs inside
  // Cloudflare Workers (see lib/prisma.ts). Driver adapters are GA in Prisma 6.19.
  provider        = "prisma-client-js"
  // Lets heavy reads load nested relations in one SQL statement
  // (relationLoadStrategy: "join") instead of one query per relation.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

// Cấp bậc. Mỗi cấp có sẵn một nhóm quyền (lib/permissions.ts); quản lý có thể
// cấp thêm quyền cho từng người ở cấp thấp hơn qua User.permissions.
enum Role {
  ADMIN // quản trị viên: toàn quyền, quản lý mọi tài khoản
  MANAGER // quản lý: tạo & quản lý mọi dự án, quản lý nhân viên cấp dưới
  LEAD // trưởng nhóm: tạo dự án và quản lý dự án của mình
  MEMBER // nhân viên: thực hiện công việc, gửi báo cáo
}

// Quyền có thể cấp thêm cho từng người (ngoài quyền sẵn có của cấp bậc).
enum Permission {
  PROJECT_CREATE // tạo dự án mới (trở thành quản lý dự án đó)
  PROJECT_VIEW_ALL // xem mọi dự án và số liệu tổng hợp
  PROJECT_MANAGE_ALL // quản lý mọi dự án, duyệt mọi báo cáo
  USER_MANAGE // thêm tài khoản, phân quyền, đặt lại mật khẩu cho cấp dưới
  FINANCE_MANAGE // xem & cập nhật hợp đồng, chi phí, lợi nhuận, công nợ
}

// Tiến độ thực hiện hợp đồng
enum ContractStatus {
  PLANNED // chưa triển khai
  IN_PROGRESS // đang triển khai
  TESTING // khảo thí
  COMPLETED // hoàn thành
}

// Vai trò trong từng dự án.
enum ProjectRole {
  MANAGER // quản lý dự án: sửa dự án, hạng mục, thành viên, mọi công việc; duyệt báo cáo
  MEMBER // thành viên: tạo công việc, cập nhật & báo cáo việc mình phụ trách
  VIEWER // chỉ xem: xem dự án và gửi ghi chú / phản hồi
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NoteType {
  NOTE // ghi chú nội bộ
  FEEDBACK // phản hồi / góp ý
}

// Kỳ của báo cáo công việc (lib/work-report.ts)
enum WorkReportPeriod {
  WEEK // tuần ISO: thứ Hai 00:00 → Chủ nhật 23:59 (APP_TIMEZONE)
  MONTH
}

enum WorkReportStatus {
  DRAFT // đang soạn, chưa gửi
  SUBMITTED // đã gửi cấp trên
}

// ----------------------------------------------------------------------------
// Models
// ----------------------------------------------------------------------------

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  passwordHash       String
  role               Role         @default(MEMBER)
  // Quyền được cấp thêm ngoài quyền sẵn có của cấp bậc
  permissions        Permission[] @default([])
  jobTitle           String? // chức danh
  avatarColor        String       @default("#6366f1")
  active             Boolean      @default(true)
  // Bảo mật: buộc đổi mật khẩu ở lần đăng nhập đầu / sau khi admin reset
  mustChangePassword Boolean      @default(false)
  // Tăng lên mỗi khi đổi mật khẩu -> vô hiệu hoá mọi phiên đăng nhập cũ
  tokenVersion       Int          @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  ownedProjects   Project[]       @relation("ProjectOwner")
  memberships     ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreator")
  taskReports     TaskReport[]    @relation("ReportAuthor")
  reviewedReports TaskReport[]    @relation("ReportReviewer")
  notes           Note[]
  contracts       Contract[]
  workReports     WorkReport[]    @relation("WorkReportAuthor")
  reviewedWork    WorkReport[]    @relation("WorkReportReviewer")
  contractFiles   ContractFile[]
  auditLogs       AuditLog[]      @relation("AuditActor")
  settingsChanged AppSetting[]    @relation("SettingUpdater")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  color       String        @default("#6366f1")
  startDate   DateTime?
  dueDate     DateTime?
  ownerId     String
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categories Category[]
  tasks      Task[]
  members    ProjectMember[]
  notes      Note[]
  contracts  Contract[]

  @@index([ownerId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// Hạng mục trong một dự án (nhóm các task). Hai cấp: hạng mục lớn và hạng mục
// con (parentId trỏ tới hạng mục lớn), mỗi cấp có thời hạn riêng.
model Category {
  id        String     @id @default(cuid())
  name      String
  color     String     @default("#64748b")
  order     Int        @default(0)
  startDate DateTime?
  dueDate   DateTime?
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("SubCategories")
  tasks     Task[]
  createdAt DateTime   @default(now())

  @@index([projectId])
  @@index([parentId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  progress    Int        @default(0) // 0-100
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Subtask: parent/child trên cùng model
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  // PIC (người phụ trách)
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  reports   TaskReport[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([projectId])
  @@index([categoryId])
  @@index([assigneeId])
  @@index([parentId])
}

// Báo cáo tiến độ của người thực hiện cho một task
model TaskReport {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  progress   Int      @default(0) // tiến độ báo cáo tại thời điểm đó
  hoursSpent Float    @default(0)
  createdAt  DateTime @default(now())

  // Quản lý xem xét / phản hồi báo cáo
  reviewerId String?
  reviewer   User?     @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  reviewNote String?

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
  @@index([reviewedAt])
}

// Ghi chú / phản hồi cho dự án
model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type      NoteType @default(NOTE)
  content   String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

// Hợp đồng & chi phí (báo cáo tài chính). Số tiền tính bằng VNĐ, số nguyên.
// Lợi nhuận, tỷ suất, công nợ và trạng thái thanh toán được tính từ các cột này
// (lib/finance.ts), không lưu lại.
model Contract {
  id             String         @id @default(cuid())
  code           String? // mã hợp đồng
  name           String // tên hợp đồng / dự án
  partner        String? // đối tác / khách hàng
  value          BigInt // giá trị hợp đồng
  performedAt    DateTime // ngày (tháng) thực hiện
  status         ContractStatus @default(IN_PROGRESS)
  trainingCost   BigInt         @default(0) // chi phí đào tạo
  examCost       BigInt         @default(0) // chi phí khảo thí
  otherCost      BigInt         @default(0) // chi phí khác
  // Tỷ suất lợi nhuận dự kiến (%), dùng để ước tính khi chưa nhập chi phí
  expectedMargin Float?
  collected      BigInt         @default(0) // đã thu
  note           String?
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  files          ContractFile[]

  @@index([performedAt])
  @@index([projectId])
}

// Báo cáo công việc tuần / tháng của một người gửi cấp trên. Danh sách công việc
// luôn được tính trực tiếp từ task của người đó (lib/work-report-queries.ts); bảng
// này chỉ lưu phần người viết tự ghi và bản chụp danh sách lúc gửi.
model WorkReport {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("WorkReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  period      WorkReportPeriod
  // Đầu kỳ: thứ Hai 00:00 hoặc ngày 1 lúc 00:00 theo APP_TIMEZONE
  periodStart DateTime
  doneNote    String? // kỳ trước đã làm: kết quả nổi bật
  doingNote   String? // kỳ này đang làm: ghi chú
  planNote    String? // kỳ tới: kế hoạch
  issues      String? // khó khăn / đề xuất
  status      WorkReportStatus @default(DRAFT)
  submittedAt DateTime?
  // Danh sách công việc và ghi chú lúc gửi (WorkSnapshot), để so với hiện tại
  snapshot    Json?

  // Cấp trên xem xét
  reviewedById String?
  reviewedBy   User?     @relation("WorkReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, period, periodStart])
  @@index([period, periodStart])
}

// Hồ sơ hợp đồng: file PDF (bản ký, bản scan) để lưu trữ và báo cáo. Bảng này
// chỉ giữ thông tin file; nội dung nằm ở ContractFileBlob nên danh sách và
// include không bao giờ tải các byte của file. Xoá hợp đồng thì xoá file.
model ContractFile {
  id           String            @id @default(cuid())
  contractId   String
  contract     Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name         String // tên file gốc (đã chuẩn hoá)
  size         Int // số byte
  mimeType     String            @default("application/pdf")
  uploadedById String
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime          @default(now())
  blob         ContractFileBlob?

  @@index([contractId])
}

// Nội dung file, 1:1 với ContractFile, chỉ đọc/ghi qua lib/file-storage.ts
// (có thể chuyển sang Cloudflare R2 mà không đổi phần còn lại).
model ContractFileBlob {
  fileId String       @id
  file   ContractFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  data   Bytes
}

// Nhật ký thao tác (chỉ quản trị viên xem, trong Cài đặt): ai làm gì, lúc nào, từ đâu.
// Tên người thực hiện được chép lại để nhật ký vẫn đọc được khi tài khoản đổi tên.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  // Mã thao tác, ví dụ "contract.update" (danh sách ở lib/audit-actions.ts)
  action     String
  entityType String
  entityId   String?
  // Mô tả ngắn, tiếng Việt, hiển thị trong bảng nhật ký
  summary    String
  // Chi tiết thay đổi (trường nào, giá trị trước/sau), không bao giờ chứa mật khẩu
  details    Json?
  ip         String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// Cài đặt hệ thống do quản trị viên chỉnh (ví dụ khoá Claude API cho trợ lý AI).
// value là JSON; bí mật trong đó luôn được mã hoá (lib/secret-box.ts), không lưu dạng rõ.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}
